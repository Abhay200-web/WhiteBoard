{
  "name": "@whiteboard/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "React + Vite UI (runs inside the desktop app; also in a plain browser for dev and E2E tests)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@whiteboard/config": "workspace:*",
    "jsdom": "31.0.0",
    "msw": "3.0.5",
    "tailwindcss": "4.3.5",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@tanstack/react-query": "5.107.1",
    "@whiteboard/core": "workspace:*",
    "@whiteboard/editor": "workspace:*",
    "@whiteboard/ui": "workspace:*",
    "pdfjs-dist": "^6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "zod": "4.6.7"
  }
}
