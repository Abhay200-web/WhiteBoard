# Dev settings for the Host server. All optional — the values below are the defaults. Set them as environment variables (nothing reads a .env file yet).

# Port the Host server listens on
WB_PORT=47800
# Address to listen on (0.0.0.0 = reachable from other office PCs; 127.0.0.1 = this PC only)
WB_HOST=0.0.0.0
# Data folder for the dev Host (SQLite file, files, logs)
WB_DATA_DIR=./.data
